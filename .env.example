# ==============================================================================
# AgriStack DBT Core — Environment Configuration Template
# Copy this file to .env for local development
# ==============================================================================

# Application Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Zero-Trust Security Secrets (Layer 2 Tokenization & G2P Connect Signing)
AGRISTACK_PEPPER_SECRET=sovereign_karnal_pilot_hmac_pepper_2026_secret_key
G2P_CONNECT_SIGNING_SECRET=sovereign_g2p_connect_hmac_signing_key_2026

# Layer 2 Ingress Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CAPACITY=10

# ------------------------------------------------------------------------------
# Layer 1 & 4 Multichannel Carrier Interfaces
# ------------------------------------------------------------------------------
# WhatsApp Business Cloud API Gateway identifier
WHATSAPP_INTERFACE_ID=WHATSAPP_GATEWAY_DEFAULT

# IVR Telephony SIP Trunk Gateway identifier
IVR_INTERFACE_ID=IVR_GATEWAY_DEFAULT

# USSD Cellular SS7/SIGTRAN Gateway identifier
USSD_INTERFACE_ID=USSD_GATEWAY_DEFAULT

# Transactional SMS Gateway identifier
SMS_INTERFACE_ID=SMS_GATEWAY_DEFAULT

# Grievance / Kisan Call Center Toll-Free Helpline Number
HELPLINE_NUMBER=1800-180-1551

# ------------------------------------------------------------------------------
# Sovereign DPI Boundary Endpoints & API Keys (Mocked in Local Dev)
# ------------------------------------------------------------------------------
# Bhashini Indic AI Speech & Translation Platform (MeitY ULCA / Dhruva Pipeline)
BHASHINI_API_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_API_KEY=mock_bhashini_key_dev

# OpenSPP / OpenG2P Beneficiary Social Protection Platform Connector
OPENSPP_API_ENDPOINT=https://openspp.gov.in/api/v1
OPENSPP_API_KEY=mock_openspp_key_dev

# NPCI APBS / PFMS Treasury Financial Clearing Rails
NPCI_APBS_API_ENDPOINT=https://npci.org.in/apbs/v1
NPCI_APBS_API_KEY=mock_npci_key_dev

# AgriStack Authoritative Cadastral Land Registry Gateway
AGRISTACK_REGISTRY_API_ENDPOINT=https://agristack.gov.in/api/v1
AGRISTACK_REGISTRY_API_KEY=mock_agristack_key_dev

# Digital Crop Survey & Satellite Multi-Spectral Stress Verification Gateway
CROP_SATELLITE_API_ENDPOINT=https://dcs-satellite.agristack.gov.in/api/v1
CROP_SATELLITE_API_KEY=mock_crop_satellite_key_dev

# Data DHARA (NMDS 2.0) Scheme Policy & Calamity Notification MCP Server
SCHEME_POLICY_API_ENDPOINT=https://dhara-mcp.mospi.gov.in
SCHEME_POLICY_API_KEY=mock_scheme_policy_key_dev

# MOSIP Sovereign Identity Verification Gateway
MOSIP_API_ENDPOINT=https://mosip.gov.in/api/v1
MOSIP_API_KEY=mock_mosip_key_dev

# Sovereign SLM Entity Extraction Service
SLM_API_ENDPOINT=https://slm.sovereign-ai.gov.in/v1
SLM_API_KEY=mock_slm_key_dev

# Database Configuration (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql+psycopg://agristack:agristack@localhost:5432/agristack_dbt
